# Copy this file to .env.local and fill in your values (never share .env.local).

# Admin panel password — used to sign in at /admin
ADMIN_PASSWORD=choose-a-strong-password
# Any long random text; changing it logs everyone out
ADMIN_SECRET=change-me-to-a-long-random-string

# Cloudinary (Dashboard → Product Environment → API Keys)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
